# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# --- postgres (matches docker-compose.yml) ---
# Port 5433 on the host, not 5432, so this stack can run alongside other local
# Postgres containers (the ebike project uses 5432).
POSTGRES_USER=office360
POSTGRES_PASSWORD=office360_dev
POSTGRES_DB=office360
POSTGRES_PORT=5433

# --- api ---
# Used by the Go server and by `migrate`.
DATABASE_URL=postgres://office360:office360_dev@localhost:5433/office360?sslmode=disable
API_PORT=8080
API_ENV=development

# Comma-separated origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:5173

# --- web ---
# Read by SvelteKit at build/run time.
PUBLIC_API_URL=http://localhost:8080
