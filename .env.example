# Copy to .env and adjust. .env is gitignored — never commit real secrets.

# --- postgres (matches docker-compose.yml) ---
# Port 5434 on the host. 5432 is taken by a host Postgres and 5433 by the
# ebike stack's container, so this project claims the next free one.
POSTGRES_USER=office360
POSTGRES_PASSWORD=office360_dev
POSTGRES_DB=office360
POSTGRES_PORT=5434

# --- api ---
# Used by the Go server and by `migrate`.
DATABASE_URL=postgres://office360:office360_dev@localhost:5434/office360?sslmode=disable
API_PORT=8080
API_ENV=development

# Signing key for session tokens. Must be at least 32 characters or the server
# refuses to start. Generate a real one per environment - never reuse this value
# outside local development:
#   openssl rand -base64 48
JWT_SECRET=dev_only_change_me_0123456789_abcdefghijklmnop

# Comma-separated origins allowed to call the API from the browser.
CORS_ORIGINS=http://localhost:5173

# --- web ---
# Read by SvelteKit at build/run time.
PUBLIC_API_URL=http://localhost:8080

# The organisation the web app acts as, sent as X-Organization-Id.
#
# INTERIM - Day 3 adds login and Day 4 moves the organisation onto the session
# token, at which point this variable and the header both disappear.
#
# The value below is the "Demo Organisation" created by ./make.ps1 seed. Run
# that after ./make.ps1 migrate or every page will be empty: a request naming an
# organisation that does not exist is not an error, it simply matches no rows.
# Leaving this blank is different - the API fails closed and returns 401.
#
# ...0002 is the second seeded organisation, for checking tenant isolation by
# hand: point this at it and the demo rows must disappear.
PUBLIC_DEV_ORGANIZATION_ID=00000000-0000-7000-8000-000000000001
